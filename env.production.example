# Production Environment Variables
# Copy this to .env.production.local for local production testing
# For Vercel deployment, add these in the Vercel dashboard

# Database - Use PostgreSQL for production
DATABASE_URL="postgresql://username:password@host:port/database?schema=public"

# JWT Secret - Generate a secure random string (minimum 32 characters)
JWT_SECRET="your-super-secure-jwt-secret-key-minimum-32-characters-long"

# Environment
NODE_ENV="production"

# Optional: Custom port (Vercel handles this automatically)
PORT=3000
