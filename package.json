{
  "name": "trading-simulation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/update-ip.js && next dev -H 0.0.0.0",
    "dev:auto": "node scripts/update-ip.js && next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "start:legacy": "echo 'Legacy start scripts removed - use npm run app instead'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "logs": "tail -f logs/app.log",
    "clean": "rm -rf .next node_modules package-lock.json",
    "postinstall": "npx prisma generate",
    "lan-setup": "node scripts/lan-setup.js",
    "update-lan-env": "node scripts/update-lan-env.js",
    "update-ip": "node scripts/update-ip.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^5.6.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lightweight-charts": "^4.1.3",
    "lucide-react": "^0.292.0",
    "next": "^14.2.33",
    "prisma": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
