# Environment Variables for Trading Simulation App
# Copy this file to .env.local and update with your values

# JWT Secret - Generate a strong secret key (32+ characters)
JWT_SECRET=supersecurejwtsecretkeyforproductionsimulation2024

# Database URL - PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/trading_simulation

# Node Environment
NODE_ENV=development

# Port (optional)
PORT=3000

# Hostname (optional)
HOSTNAME=localhost
